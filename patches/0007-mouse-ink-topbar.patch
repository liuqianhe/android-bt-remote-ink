+@Composable
+private fun MouseButton(
+    text: String,
+    touchDown: () -> Unit,
+    touchUp: () -> Unit,
+    inkStyle: Boolean,
+    modifier: Modifier = Modifier,
+    shape: Shape = RectangleShape
+) {
+    if (inkStyle) {
+        InkMouseButton(
+            text = text,
+            touchDown = touchDown,
+            touchUp = touchUp,
+            modifier = modifier,
+            shape = shape
+        )
+    } else {
+        EmptySurfaceButton(
+            touchDown = touchDown,
+            touchUp = touchUp,
+            modifier = modifier,
+            shape = shape
+        )
+    }
+}
+
+@Composable
+private fun InkMouseButton(
+    text: String,
+    touchDown: () -> Unit,
+    touchUp: () -> Unit,
+    modifier: Modifier = Modifier,
+    shape: Shape = RectangleShape
+) {
+    val interactionSource = remember { MutableInteractionSource() }
+    val isPressed by interactionSource.collectIsPressedAsState()
+    val haptic = LocalHapticFeedback.current
+
+    LaunchedEffect(interactionSource) {
+        interactionSource.interactions.collect { interaction ->
+            when (interaction) {
+                is PressInteraction.Press -> {
+                    haptic.performHapticFeedback(HapticFeedbackType.LongPress)
+                    touchDown()
+                }
+                is PressInteraction.Release -> touchUp()
+                is PressInteraction.Cancel -> touchUp()
+            }
+        }
+    }
+
+    Box(
+        modifier = modifier
+            .clip(shape)
+            .background(if (isPressed) Color.Black else Color.White)
+            .border(2.dp, Color.Black, shape)
+            .clickable(
+                interactionSource = interactionSource,
+                indication = null,
+                onClick = {}
+            ),
+        contentAlignment = Alignment.Center
+    ) {
+        TextNormal(
+            text = text,
+            color = if (isPressed) Color.White else Color.Black
+        )
+    }
+}
