+                NumpadRow(
+                    keys = arrayOf(
+                        "1" to KeyboardKey.KEY_NUM_1,
+                        "2" to KeyboardKey.KEY_NUM_2,
+                        "3" to KeyboardKey.KEY_NUM_3
+                    ),
+                    sendKeyboardKeyReport = sendKeyboardKeyReport,
+                    inkStyle = inkStyle,
+                    modifier = Modifier.weight(1f)
+                )
+
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .weight(1f),
+                    horizontalArrangement = Arrangement.spacedBy(gap)
+                ) {
+                    NumpadKey(
+                        text = "0",
+                        key = KeyboardKey.KEY_NUM_0,
+                        sendKeyboardKeyReport = sendKeyboardKeyReport,
+                        inkStyle = inkStyle,
+                        modifier = Modifier.weight(2f)
+                    )
+                    NumpadKey(
+                        text = ".",
+                        key = KeyboardKey.KEY_NUM_DOT,
+                        sendKeyboardKeyReport = sendKeyboardKeyReport,
+                        inkStyle = inkStyle,
+                        modifier = Modifier.weight(1f)
+                    )
+                }
+            }
+
+            Column(
+                modifier = Modifier.weight(1f),
+                verticalArrangement = Arrangement.spacedBy(gap)
+            ) {
+                NumpadKey(
+                    text = "+",
+                    key = KeyboardKey.KEY_NUM_ADD,
+                    sendKeyboardKeyReport = sendKeyboardKeyReport,
+                    inkStyle = inkStyle,
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .weight(2f)
+                )
+                NumpadKey(
+                    text = "Enter",
+                    key = KeyboardKey.KEY_NUM_ENTER,
+                    sendKeyboardKeyReport = sendKeyboardKeyReport,
+                    inkStyle = inkStyle,
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .weight(2f)
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun NumpadRow(
+    keys: Array<Pair<String, KeyboardKey>>,
+    sendKeyboardKeyReport: (ByteArray) -> Unit,
+    inkStyle: Boolean,
+    modifier: Modifier = Modifier
+) {
+    Row(
+        modifier = modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(dimensionResource(id = R.dimen.padding_small))
+    ) {
+        keys.forEach { (text, key) ->
+            NumpadKey(
+                text = text,
+                key = key,
+                sendKeyboardKeyReport = sendKeyboardKeyReport,
+                inkStyle = inkStyle,
+                modifier = Modifier.weight(1f)
+            )
+        }
+    }
+}
+
+@Composable
+private fun NumpadKey(
+    text: String,
+    key: KeyboardKey,
+    sendKeyboardKeyReport: (ByteArray) -> Unit,
+    inkStyle: Boolean,
+    modifier: Modifier = Modifier
+) {
+    val shape = RoundedCornerShape(dimensionResource(id = R.dimen.keyboard_key_corner_radius))
+    val touchDown = {
+        sendKeyboardKeyReport(byteArrayOf(0x00, key.byte))
+    }
+    val touchUp = {
+        sendKeyboardKeyReport(REMOTE_INPUT_NONE)
+    }
+
+    if (inkStyle) {
+        RawButton(
+            touchDown = touchDown,
+            touchUp = touchUp,
+            modifier = modifier,
+            shape = shape
+        ) {
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .background(Color.White)
+                    .border(2.dp, Color.Black, shape),
+                contentAlignment = Alignment.Center
+            ) {
+                AdaptiveText(
+                    text = text,
+                    percent = 0.5f,
+                    modifier = Modifier
+                        .fillMaxSize()
+                        .padding(dimensionResource(id = R.dimen.padding_small)),
+                    color = Color.Black,
+                    textAlign = TextAlign.Center
+                )
+            }
+        }
+    } else {
+        TextKeyboardKey(
+            text = text,
+            touchDown = touchDown,
+            touchUp = touchUp,
+            modifier = modifier,
+            shape = shape,
+            elevation = surfaceElevationHigh()
+        )
+    }
+}
